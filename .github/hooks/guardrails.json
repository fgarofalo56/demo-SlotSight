{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/main/src/vs/workbench/contrib/chat/common/hooks/hookSchema.json",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/inject_context.py",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/guard_secrets.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/format_and_lint.py",
        "timeout": 60
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python .github/hooks/scripts/verify_gates.py",
        "timeout": 20
      }
    ]
  }
}
