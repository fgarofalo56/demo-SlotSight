# ═══════════════════════════════════════════════════════════════════════════
# SlotSight — environment template
#
#   cp .env.example .env     then fill in YOUR values
#
# ⚠  .env is gitignored. This file (.env.example) is the ONLY .env* tracked
#    by git, and it must contain PLACEHOLDERS ONLY — never a real value.
#    See SECURITY.md.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────────────────────────────
# docker compose provides this automatically; override only for local runs
# against a database outside compose.
POSTGRES_USER=slotsight
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=slotsight
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full SQLAlchemy URL. Leave unset to have it assembled from the parts above.
# DATABASE_URL=postgresql+asyncpg://slotsight:change-me-local-only@db:5432/slotsight

# ───────────────────────────────────────────────────────────────────────────
# Azure OpenAI  —  REQUIRED for /api/chat
# ───────────────────────────────────────────────────────────────────────────
# The analytics, dashboard, and recommendation endpoints are deterministic SQL
# and work WITHOUT any of this. Only the conversational endpoint needs it.
#
# 🔑 AUTH IS ENTRA ID — THERE IS NO API KEY.
#    Run `az login`. The app uses DefaultAzureCredential, so it picks up your
#    Azure CLI identity locally and the managed identity in Azure.
#    Your account needs the "Cognitive Services OpenAI User" role on the
#    resource.

# Your Azure OpenAI / AI Foundry endpoint.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/

# The *deployment name* you created — NOT the underlying model name.
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# API version. Bump only if you know you need to.
AZURE_OPENAI_API_VERSION=2024-10-21

# ───────────────────────────────────────────────────────────────────────────
# Application
# ───────────────────────────────────────────────────────────────────────────
# debug | info | warning | error
LOG_LEVEL=info

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Property branding shown in the UI.
PROPERTY_NAME=Neon Palms Casino Resort
PROPERTY_SHORT_NAME=Neon Palms

# ───────────────────────────────────────────────────────────────────────────
# Synthetic data generator
# ───────────────────────────────────────────────────────────────────────────
# Fixed seed keeps the demo narrative identical on every re-seed. Change it
# and the planted signals move — the golden tests in
# apps/api/tests/test_scenarios.py will fail. That's intentional.
SEED_RANDOM_SEED=20251107
SEED_MACHINE_COUNT=840
SEED_DAYS_OF_HISTORY=180

# ───────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — only VITE_* vars are exposed to the browser bundle.
# ───────────────────────────────────────────────────────────────────────────
# ⚠  NEVER put a secret in a VITE_* variable. Vite inlines these into the
#    client bundle, where anyone can read them with devtools.
VITE_API_BASE_URL=http://localhost:8000
